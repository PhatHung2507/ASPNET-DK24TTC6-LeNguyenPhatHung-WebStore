@using WebStore.Models.Entities
@model WebStore.Models.PageViewModel<WebStore.Models.Entities.ProductCategory>

@{
    ViewData["Title"] = "Loại đồng hồ";
}

<!-- Form tìm kiếm -->
<form method="get">
    <div class="search-form">
        <div class="item">
            <div class="name">Tên loại</div>
            <div class="val">
                <input type="text" class="form-control TextBox" name="name" value="@ViewData["SearchName"]" />
            </div>
        </div>
        <div class="item">
            <div class="name"></div>
            <div class="val">
                <button class="Button" type="submit">
                    <i class="fa fa-search icon"></i>Lọc dữ liệu
                </button>
                <a href="/list/productCategorylist" class="Button">
                    <i class="fa fa-refresh icon"></i>
                </a>
            </div>
        </div>
    </div>
</form>
<div class="clear10"></div>
@await Component.InvokeAsync("PermissionButtons", new { menuId = "LOAISANPHAM", modal = "modalProductCategory" })
<div class="clear10"></div>
<div id="dataTableContainer">
    @await Html.PartialAsync("~/Views/List/ProductCategoryTable.cshtml", Model)
</div>
<!-- Modal -->
@await Html.PartialAsync("ShowFormPartial", Model, new ViewDataDictionary(ViewData) { { "ModalId", "modalProductCategory" } })

<!-- Scripts -->
@section Scripts {
    <script>
        $(function () {
            setupDeleteButton(".btn-delete", ".data-row", function ($row) {
                return $row.data("id");
            }, "/list/productCategorylist/delete/", "/list/productCategorylist/partialTableProductCategory");
        });
    </script>
}
