@model WebStore.Models.Entities.Supplier

@{
    Layout = null;
}

<html xmlns="http://www.w3.org/1999/xhtml">
<body>
    <div class="edit-page">
        <div class="edit-page-content">
            <form id="formAdmin" method="post" action="/list/supplieredit">
                <div class="row col-space-10">
                    <div class="col-12">
                        <input type="hidden" name="Id" value="@Model?.Id" />
                        <div class="field-edit">
                            <span>Tên nhà cung cấp (<span class="required-span">*</span>)</span>
                            <input type="text" class="form-control TextBox" name="Name" value="@Model?.Name" required />
                        </div>
                        <div class="field-edit">
                            <span>Điện thoại</span>
                            <input type="text" class="form-control TextBox" name="Tel" value="@Model?.Tel" />
                        </div>
                        <div class="field-edit">
                            <span>Địa chỉ</span>
                            <input type="text" class="form-control TextBox" name="Address" value="@Model?.Address" />
                        </div>
                        <div class="field-edit">
                            <span>Email</span>
                            <input type="text" class="form-control TextBox" name="Email" value="@Model?.Email" />
                        </div>
                    </div>
                </div>
                <div class="save-control-button">
                    <button type="submit" class="Button2"><i class="fa fa-save icon"></i>Lưu</button>
                    <button type="button" class="Button4" id="btnClose"><i class="fa fa-remove icon"></i>Đóng</button>
                </div>
            </form>
        </div>
    </div>

    <script>
            $(function () {
            // Đóng modal khi bấm nút Đóng
            $("#btnClose").click(function () {
                $(".custom-modal").hide();
            });

            // Xử lý submit form bằng ajax
            $("#formAdmin").submit(function (e) {
                e.preventDefault();

                var form = $(this)[0]; // Lấy DOM element form
                var formData = new FormData(form); // Tạo FormData từ form

                $.ajax({
                    url: $(this).attr("action"),
                    type: "POST",
                    data: formData,
                    contentType: false,  // Bắt buộc cho FormData
                    processData: false,  // Bắt buộc cho FormData
                    success: function (response) {
                        $(".custom-modal").hide();
                        reloadAdminTable("/list/supplierlist/partialTableSupplier");
                    },
                    error: function () {
                        alert("Lỗi khi lưu dữ liệu!");
                    }
                });
            });
        });
    </script>
</body>
</html>
