@model WebStore.Models.PageViewModel<WebStore.Models.Entities.ProductCategory>
<div class="table-container">
    <table class="data-table">
        <colgroup>
            <col>
            <col>
            <col>
            <col>
        </colgroup>
        <thead>
            <tr>
                <th>Tên</th>
                <th>Sắp xếp</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr class="data-row" data-id="@item.Id">
                    <td>@item.Name</td>
                    <td class="text-center">@item.SortOrder</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@{
    Model.BaseUrl = "/list/productCategorylist/partialTableProductCategory";
    Model.ReloadFunctionName = "reloadAdminTable";
}
@await Html.PartialAsync("PaginationPartial", Model)



