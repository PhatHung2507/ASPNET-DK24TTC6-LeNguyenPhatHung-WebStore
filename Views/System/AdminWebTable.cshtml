@model WebStore.Models.PageViewModel<WebStore.Models.Entities.AdminWeb>
@using System.Linq
<div class="table-container">
    <table class="data-table">
        <colgroup>
            <col>
            <col>
            <col>
            <col>
        </colgroup>
        <thead>
            <tr>
                <th>Mã</th>
                <th>Tên</th>
                <th>Điện thoại</th>
                <th>Là Admin</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr class="data-row" data-id="@item.Id">
                    <td class="text-center">@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Phone</td>
                    <td class="text-center"><input type="checkbox" @(item.AdminYn ? "checked" : "") /></td>
                </tr>
            }
        </tbody>
    </table>
</div>
@{
    Model.BaseUrl = "/system/adminweblist/partialTableAdminWeb";
    Model.ReloadFunctionName = "reloadAdminTable";
}
@await Html.PartialAsync("PaginationPartial", Model)