@model WebStore.Models.PageViewModel<WebStore.Models.Entities.MenuItemWeb>
@using System.Linq
<div class="table-container">
    <table class="data-table">
        <colgroup>
            <col>
            <col>
            <col>
            <col>
            <col>
            <col>
            <col>
        </colgroup>
        <thead>
            <tr>
                <th>Danh mục</th>
                <th>Mã</th>
                <th>Tên</th>
                <th>List Url</th>
                <th>Edit Url</th>
                <th>Hiển thị</th>
                <th>Sắp xếp</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr class="data-row" data-id="@item.Id">
                    <td>@item.MenuCategoryWeb?.Name</td>
                    <td class="text-center">@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Url</td>
                    <td>@item.EditUrl</td>
                    <td class="text-center"><input type="checkbox" @(item.Visible ? "checked" : "") /></td>
                    <td class="text-center">@item.SortOrder</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@{
    Model.BaseUrl = "/system/menuitemweblist/partialTableMenuitemWeb";
    Model.ReloadFunctionName = "reloadAdminTable";
}
@await Html.PartialAsync("PaginationPartial", Model)