@model WebStore.Models.AdminWebByPermissionViewModel
@removeTagHelper "Microsoft.AspNetCore.Mvc.TagHelpers.OptionTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers"


@{
    Layout = null;
}

<html xmlns="http://www.w3.org/1999/xhtml">
<body>
    <div class="edit-page">
        <div class="edit-page-content">
            <form id="formAdmin" method="post" action="/system/adminwebedit">
                <div class="row col-space-10">
                    <div class="col-12">
                        <input type="hidden" name="Id" value="@Model?.AdminWeb.Id" />
                        <div class="field-edit">
                            <span>Tên nhân viên (<span class="required-span">*</span>)</span>
                            <input type="text" class="form-control TextBox" name="Name" value="@Model?.AdminWeb.Name" required />
                        </div>
                        <div class="field-edit">
                            <span>Mật khẩu (<span class="required-span">*</span>)</span>
                            <input type="password" class="form-control TextBox" name="Password" value="@Model?.AdminWeb.Password" required />
                        </div>
                        <div class="field-edit">
                            <span>Điện thoại</span>
                            <input type="text" class="form-control TextBox" name="Phone" value="@Model?.AdminWeb.Phone" />
                        </div>
      @*                   <div class="field-edit">
                            <div class="field-group">
                                <input type="checkbox" name="AdminYn" value="true" @(Model?.AdminWeb.AdminYn == true ? "checked" : "") />
                                <label>Là Admin</label>
                            </div>
                        </div> *@
                        <div class="field-edit">
                            <span>Quyền</span>
                            <select class="form-control select2 SelectDate" name="PermissionId">
                                <option value=""></option>
                                @foreach (var permission in Model.Permissions)
                                {
                                    var selectedAttr = Model.AdminWeb.PermissionId == permission.Id ? "selected" : "";
                                    <option value="@permission.Id" @selectedAttr>@permission.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="save-control-button">
                    <button type="submit" class="Button2"><i class="fa fa-save icon"></i>Lưu</button>
                    <button type="button" class="Button4" id="btnClose"><i class="fa fa-remove icon"></i>Đóng</button>
                </div>
            </form>
        </div>
    </div>

    <script>
            $(function () {
            initSelect2('.select2');

            // Xử lý submit form bằng ajax
            $("#formAdmin").submit(function (e) {
                e.preventDefault();

                var form = $(this)[0]; // Lấy DOM element form
                var formData = new FormData(form); // Tạo FormData từ form

                $.ajax({
                    url: $(this).attr("action"),
                    type: "POST",
                    data: formData,
                    contentType: false,  // Bắt buộc cho FormData
                    processData: false,  // Bắt buộc cho FormData
                    success: function (response) {
                        $(".custom-modal").hide();
                        reloadAdminTable("/system/adminweblist/partialTableAdminWeb");
                    },
                    error: function () {
                        alert("Lỗi khi lưu dữ liệu!");
                    }
                });
            });
        });
    </script>
</body>
</html>
